# Datasets, extracted features and run outputs are never committed.
# Git cannot re-include paths under an excluded directory, so each level is
# unwound explicitly to keep the SAR-RARP50 context-state labels tracked.
data/*
!data/SAR_RARP50/
data/SAR_RARP50/*
!data/SAR_RARP50/context_labels/

outputs/
results/
profile_reports/
exp_log/
exp_log_*/

# Model artifacts
*.pth
*.pt
*.ckpt
*.npy
*.pkl
weight/

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Logs and scratch
*.log
.DS_Store
